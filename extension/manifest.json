{
  "manifest_version": 3,
  "name": "NOL 취소표 알리미",
  "short_name": "nol-cancel-alert",
  "version": "0.6.0",
  "description": "NOL 티켓 취소표를 감지해 알리고 좌석을 강조합니다. 좌석 선택과 결제는 사용자가 직접 합니다.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "NOL 취소표 알리미",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://tickets.interpark.com/onestop/*",
    "https://nol.yanolja.com/*",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tickets.interpark.com/onestop/*"
      ],
      "js": [
        "content/net-tap.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tickets.interpark.com/onestop/*"
      ],
      "js": [
        "shared/types.js",
        "shared/seat-parse.js",
        "shared/page-signals.js",
        "content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
